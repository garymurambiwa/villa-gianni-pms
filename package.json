{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.3.0",
  "description": "Core DPMS desktop application packaged with Electron and a Windows NSIS installer.",
  "author": "COREPMS",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 8081",
    "start": "node server/index.cjs",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "clean": "rimraf dist release_* release-*",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "node scripts/bench.js",
    "db:check": "node scripts/db-connection-check.js",
    "release": "node scripts/release.cjs",
    "audit": "npm audit --audit-level=moderate",
    "security:check": "node scripts/security-check.js",
    "db:acid": "node scripts/db-acid-check.js",
    "env:validate": "node scripts/env-validate.js",
    "preview": "vite preview",
    "electron:start": "cross-env ELECTRON_START_URL=http://localhost:8081 electron ./electron/main.cjs",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron:start\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:unsigned": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_LINK= CSC_LINK= electron-builder --win nsis --x64",
    "build:release:win": "npm run clean && npm run electron:build:unsigned",
    "build:final": "npm run clean && node scripts/prune-postgres.cjs && npm run build && cross-env ELECTRON_BUILDER_OUT_DIR=release_final electron-builder --win nsis --x64",
    "build:final:unsigned": "npm run clean && node scripts/prune-postgres.cjs && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_LINK= CSC_LINK= ELECTRON_BUILDER_OUT_DIR=release_final electron-builder --win nsis --x64",
    "checksums:win": "powershell -NoProfile -Command \"Get-ChildItem -Path 'release_v0.3.0' -Filter '*.exe' -Recurse | ForEach-Object { $h=Get-FileHash $_.FullName -Algorithm SHA256; \\\"$($h.Hash) *$($_.FullName.Replace((Resolve-Path 'release_v0.3.0').Path + '\\\\',''))\\\" } | Out-File -FilePath 'release_v0.3.0\\SHA256SUMS.txt' -Encoding ASCII\"",
    "icons:generate": "node scripts/generate-icons.cjs",
    "cleanup:mock": "node scripts/cleanup-mock-data.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.56.2",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "embla-carousel-react": "^8.3.0",
    "express": "^5.2.1",
    "highlight.js": "^11.9.0",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.462.0",
    "marked": "^12.0.1",
    "next-themes": "^0.3.0",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.26.2",
    "react-simple-keyboard": "^3.8.141",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "vaul": "^0.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^2.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^24.1.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^2.1.2"
  },
  "build": {
    "appId": "com.coredpms.app",
    "productName": "COREPMS",
    "compression": "normal",
    "directories": {
      "output": "release_final",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pg/**/*"
    ],
    "asar": true,
    "artifactName": "${productName}_${version}.${ext}",
    "extraResources": [
      {
        "from": "resources/postgres",
        "to": "postgres",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/VC_redist.x64.exe",
        "to": "prereqs/VC_redist.x64.exe"
      },
      {
        "from": "db/schema.sql",
        "to": "schema.sql"
      },
      {
        "from": "scripts/verify-install.js",
        "to": "verify-install.js"
      },
      "build/prereqs/**"
    ],
    "fileAssociations": [
      {
        "ext": "dpms",
        "name": "Core DPMS Data",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Core DPMS",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Core DPMS",
      "installerIcon": "build/installerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "license": "build/LICENSE.txt",
      "displayLanguageSelector": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "pkg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "copyright": "Copyright © 2026 COREPMS"
  }
}

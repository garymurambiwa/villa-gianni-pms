# Hotel Branding Configuration
VITE_HOTEL_NAME="Villa Gianni"
VITE_HOTEL_SHORT_NAME="VG"

NODE_ENV=production

# PostgreSQL Database Configuration (LAN)
# Replace with your actual LAN server IP and credentials
DATABASE_URL=postgres://postgres:your_secure_password@192.168.1.100:5432/corepms_db
PGHOST=192.168.1.100
PGPORT=5432
PGDATABASE=corepms_db
PGUSER=postgres
PGPASSWORD=your_secure_password

# LAN-only operation - no cloud services
VITE_USE_LOCAL_AUTH=true

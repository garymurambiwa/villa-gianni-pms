# Hotel Branding Configuration
VITE_HOTEL_NAME="Villa Gianni"
VITE_HOTEL_SHORT_NAME="VG"

NODE_ENV=development

# PostgreSQL Database Configuration (LAN)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/corepms_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=corepms_db
PGUSER=postgres
PGPASSWORD=postgres

# LAN Configuration
# Change localhost to your server's LAN IP address for network access
# Example: 192.168.1.100

# No cloud services - local operation only
VITE_USE_LOCAL_AUTH=true

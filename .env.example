# COREPMS Environment Configuration
# Copy this file to .env.development or .env.production and update values

# Hotel Branding Configuration
VITE_HOTEL_NAME="Villa Gianni"
VITE_HOTEL_SHORT_NAME="VG"

NODE_ENV=development

# PostgreSQL Database Configuration
# For LAN access, replace localhost with your server's IP address
DATABASE_URL=postgres://postgres:your_password@localhost:5432/corepms_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=corepms_db
PGUSER=postgres
PGPASSWORD=your_password

# LAN-only operation - no cloud services required
VITE_USE_LOCAL_AUTH=true

# Optional: Logging level (silent, error, warn, info, debug)
VITE_LOG_LEVEL=info

{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "installCommand": "npm install --production=false",
    "framework": null,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/db.cjs"
        },
        {
            "source": "/((?!api/).*)$",
            "destination": "/index.html"
        }
    ]
}